#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) uniform writeonly image2D heightmap;

uint Hash(uvec2 p) {
    uint value = p.x * 1597334677u ^ p.y * 3812015801u;
    value = (value ^ (value >> 16)) * 2246822519u;
    return value ^ (value >> 13);
}

vec2 Gradient(ivec2 p) {
    const vec2 gradients[8] = vec2[](
        vec2(1, 0), vec2(-1, 0), vec2(0, 1), vec2(0, -1),
        vec2(0.707107, 0.707107), vec2(-0.707107, 0.707107),
        vec2(0.707107, -0.707107), vec2(-0.707107, -0.707107)
    );
    return gradients[Hash(uvec2(p)) & 7u];
}

float Perlin(vec2 p) {
    ivec2 cell = ivec2(floor(p));
    vec2 f = fract(p);
    vec2 fade = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = dot(Gradient(cell), f);
    float b = dot(Gradient(cell + ivec2(1, 0)), f - vec2(1, 0));
    float c = dot(Gradient(cell + ivec2(0, 1)), f - vec2(0, 1));
    float d = dot(Gradient(cell + ivec2(1, 1)), f - vec2(1, 1));
    return mix(mix(a, b, fade.x), mix(c, d, fade.x), fade.y);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(heightmap);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 p = vec2(pixel) / vec2(size - 1) * 1.5 + vec2(17.3, 43.7);
    float height = 0.0;
    float amplitude = 0.5;
    float weight = 0.0;

    for (int octave = 0; octave < 4; ++octave) {
        height += amplitude * Perlin(p);
        weight += amplitude;
        p *= 2.0;
        amplitude *= 0.5;
    }

    imageStore(heightmap, pixel, vec4(clamp(0.5 + height / weight, 0.0, 1.0)));
}
