#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D resultImage;

#define iResolution vec3(vec2(imageSize(resultImage)), 1.0)
#define iMouse vec4(iResolution.xy * vec2(0.62, 0.58), 0.0, 0.0)

const vec3  eye      = vec3(0.0, 0.0, 3.0);
const vec3  light    = vec3(2.0, 3.0, 4.0);
const int   maxSteps = 70;
const float eps      = 0.01;

mat3 rotateX(float theta)
{
    float c = cos(theta);
    float s = sin(theta);

    return mat3(
        vec3(1, 0, 0),
        vec3(0, c, -s),
        vec3(0, s, c)
    );
}


mat3 rotateY(float theta)
{
    float c = cos(theta);
    float s = sin(theta);

    return mat3(
        vec3(c, 0, s),
        vec3(0, 1, 0),
        vec3(-s, 0, c)
    );
}


float length8(in vec2 p)
{
    return pow(
        pow(abs(p.x), 8.0) +
        pow(abs(p.y), 8.0),
        1.0 / 8.0
    );
}


float dTorus(in vec3 p, in vec2 t)
{
    vec2 q = vec2(
        length8(p.xz) - t.x,
        p.y
    );

    return length8(q) - t.y;
}


float sdf(in vec3 p, in mat3 m)
{
    vec3 q = m * p;

    return dTorus(q, vec2(0.2, 0.1));
}


vec3 trace(
    in vec3 from,
    in vec3 dir,
    out bool hit,
    in mat3 m
)
{
    vec3 p = from;
    float totalDist = 0.0;

    hit = false;

    for (int steps = 0; steps < maxSteps; steps++)
    {
        float dist = sdf(p, m);

        if (dist < eps)
        {
            hit = true;
            break;
        }

        totalDist += dist;

        if (totalDist > 10.0)
            break;

        p += dist * dir;
    }

    return p;
}

vec3 generateNormal(
    vec3 p,
    float d,
    in mat3 m
)
{
    float e = max(d * 0.5, eps);

    float dx1 = sdf(p + vec3(e, 0, 0), m);
    float dx2 = sdf(p - vec3(e, 0, 0), m);

    float dy1 = sdf(p + vec3(0, e, 0), m);
    float dy2 = sdf(p - vec3(0, e, 0), m);

    float dz1 = sdf(p + vec3(0, 0, e), m);
    float dz2 = sdf(p - vec3(0, 0, e), m);

    return normalize(
        vec3(
            dx1 - dx2,
            dy1 - dy2,
            dz1 - dz2
        )
    );
}


void mainImage(
    out vec4 fragColor,
    in vec2 fragCoord
)
{
    bool hit;

    vec3 mouse = vec3(
        iMouse.xy / iResolution.xy - 0.5,
        iMouse.z - 0.5
    );

    mat3 m =
        rotateX(6.0 * mouse.y) *
        rotateY(6.0 * mouse.x);


    vec2 scale =
        3.0 * iResolution.xy /
        max(iResolution.x, iResolution.y);

    vec2 uv =
        scale *
        (fragCoord / iResolution.xy - vec2(0.5));


    vec3 dir =
        normalize(vec3(uv, 0.0) - eye);


    vec3 p = trace(
        eye,
        dir,
        hit,
        m
    );


    vec4 color = vec4(
        0.02,
        0.03,
        0.05,
        1.0
    );


    if (hit)
    {
        vec3 l = normalize(light - p);

        vec3 v = normalize(eye - p);

        vec3 n = generateNormal(p, eps, m);

        float nl = max(0.0, dot(n, l));

        vec3 h = normalize(l + v);

        float hn = max(0.0, dot(h, n));

        float sp = pow(hn, 80.0);

        vec3 objectColor = vec3(0.2, 0.5, 1.0);


        color =
            vec4(
                objectColor * nl +
                vec3(sp),
                1.0
            );
    }


    fragColor = color;
}


void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(resultImage);
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec2 fragCoord = vec2(float(pixel.x) + 0.5, float(size.y - 1 - pixel.y) + 0.5);
    vec4 color;
    mainImage(color, fragCoord);
    imageStore(resultImage, pixel, color);
}
