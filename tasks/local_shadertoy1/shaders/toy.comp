#version 430

layout(local_size_x = 32, local_size_y = 32) in;
layout(binding = 0, rgba8) uniform writeonly image2D resultImage;

// Push constants для передачи данных из CPU (как в рабочем примере)
layout(push_constant) uniform PushConstants {
    vec2 resolution;
    vec2 mouse;
    float time;
} pc;

// Функции SDF (оставляем без изменений)
mat2 Rot(float a) {
    float s = sin(a), c = cos(a);
    return mat2(c, -s, s, c);
}

float sdSphere(vec3 p, float r) {
    return length(p) - r;
}

float sdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdTorus(vec3 p, vec2 t) {
    vec2 q = vec2(length(p.xz) - t.x, p.y);
    return length(q) - t.y;
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float GetDist(vec3 p) {
    float cube1 = sdBox(p - vec3(0.0, 2.5, 0.0), vec3(2.0, 0.5, 3.0));
    float cube2 = sdBox(p - vec3(0.0, -2.5, 0.0), vec3(2.0, 0.5, 3.0));
    float cubes = smin(cube1, cube2, 0.5); 
    float t = pc.time * 1.5; // Используем время из push constants
    float sphereDist = 1000.0;
    
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float offset = fi * 0.5;
        float yPos = sin(t + offset) * 2.0;
        
        vec3 spherePos = vec3(0.0, yPos, fi * 1.5 - 2.25);
        float sphere = sdSphere(p - spherePos, 0.4);

        vec3 torusPos = p - spherePos;
        torusPos.xz *= Rot(t * 0.8 + offset);
        torusPos.xy *= Rot(t * 1.2 + offset);
        float torus = sdTorus(torusPos, vec2(0.6, 0.08));
        
        float obj = min(sphere, torus);
        sphereDist = smin(sphereDist, obj, 0.4);
    }
    
    return smin(cubes, sphereDist, 0.3);
}

float RayMarch(vec3 ro, vec3 rd) {
    float dO = 0.0;
    
    for (int i = 0; i < 100; i++) {
        vec3 p = ro + rd * dO;
        float dS = GetDist(p);
        dO += dS;
        if (dO > 100.0 || abs(dS) < 0.001) break;
    }
    
    return dO;
}

vec3 GetNormal(vec3 p) {
    vec2 e = vec2(0.01, 0.0);
    vec3 n = vec3(
        GetDist(p + e.xyy) - GetDist(p - e.xyy),
        GetDist(p + e.yxy) - GetDist(p - e.yxy),
        GetDist(p + e.yyx) - GetDist(p - e.yyx)
    );
    return normalize(n);
}

float GetLight(vec3 p) {
    vec3 lightPos = vec3(5.0, 3.0, 0.0);
    lightPos.yz += vec2(sin(pc.time), cos(pc.time)) * 2.0; // Используем pc.time
    
    vec3 l = normalize(lightPos - p);
    vec3 n = GetNormal(p);
    
    float dif = clamp(dot(n, l), 0.0, 1.0);
    float d = RayMarch(p + n * 0.002, l);
    if (d < length(lightPos - p)) dif *= 0.3;
    
    return dif;
}

vec3 GetBackground(vec3 rd) {
    float t = rd.y * 0.5 + 0.5;
    return mix(vec3(0.5, 0.7, 1.0), vec3(0.8, 0.9, 1.0), t);
}

void main() {
    ivec2 fragCoord = ivec2(gl_GlobalInvocationID.xy);
    
    if (fragCoord.x >= int(pc.resolution.x) || fragCoord.y >= int(pc.resolution.y)) return;
    
    vec2 uv = (vec2(fragCoord) - 0.5 * pc.resolution.xy) / pc.resolution.y;
    
    vec3 ro = vec3(-5.0, 0.0, 0.0); 
    vec3 lookat = vec3(1.0, 0.0, 0.0);
    
    vec3 forward = normalize(lookat - ro);
    vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), forward));
    vec3 up = normalize(cross(forward, right));
    
    vec3 rd = normalize(forward + right * uv.x + up * uv.y);
    
    ro.y += sin(pc.time * 0.3) * 0.1;
    
    float d = RayMarch(ro, rd);
    vec3 color = vec3(0.0);
    
    if (d < 100.0) {
        vec3 p = ro + rd * d;
        float dif = GetLight(p);
        vec3 n = GetNormal(p);
        
        vec3 surfaceColor = vec3(0.2, 0.8, 0.3);
        vec3 r = reflect(rd, n);
        vec3 env = GetBackground(r);
        
        color = surfaceColor * dif + env * 0.2;
        
        float fresnel = pow(1.0 - dot(n, -rd), 3.0);
        color += env * fresnel * 0.3;
        
        float edge = smoothstep(0.0, 0.05, abs(GetDist(p)));
        color += vec3(0.1, 0.3, 0.1) * (1.0 - edge) * 0.5;
    } else {
        color = GetBackground(rd);
    }
    
    color = pow(color, vec3(0.4545));
    
    imageStore(resultImage, fragCoord, vec4(color, 1.0));
}