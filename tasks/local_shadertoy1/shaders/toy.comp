#version 430

layout(local_size_x = 32, local_size_y = 32) in;

layout(binding = 0, rgba8) uniform image2D resultImage;

const vec2 iResolution = vec2(1280.0, 720.0);
const float iTime = 0.0;

float sdSphere(vec3 p, float r) {
    p = p - vec3(1.0, 1.0, 0.0);
    return length(p) - r;
}

float sdPlane(vec3 p, float height) {
    return p.y - height;
}

float sdBox(vec3 p, vec3 center, vec3 halfExtents) {
    vec3 q = abs(p - center) - halfExtents;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float hash(vec3 p) {
    p = fract(p * vec3(0.9, 0.8, 0.43));
    p += dot(p, p.yzx + 9.766);
    return fract((p.x + p.y) * p.z);
}

float noise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * f * (3.0 - 2.0 * f * f);

    float n000 = hash(i + vec3(0,0,0));
    float n100 = hash(i + vec3(1,0,0));
    float n010 = hash(i + vec3(0,1,0));
    float n110 = hash(i + vec3(1,1,0));
    float n001 = hash(i + vec3(0,0,1));
    float n101 = hash(i + vec3(1,0,1));
    float n011 = hash(i + vec3(0,1,1));
    float n111 = hash(i + vec3(1,1,1));

    float nx00 = mix(n000, n100, f.x);
    float nx10 = mix(n010, n110, f.x);
    float nx01 = mix(n001, n101, f.x);
    float nx11 = mix(n011, n111, f.x);

    float nxy0 = mix(nx00, nx10, f.y);
    float nxy1 = mix(nx01, nx11, f.y);

    return mix(nxy0, nxy1, f.z);
}

float sdNoisyBox(vec3 p, vec3 center, vec3 halfExtents) {
    float base = sdBox(p, center, halfExtents);
    float n = noise(p * 3.0 + iTime * 0.5) - 0.5;
    return base + n * 0.3;
}

float sdNoisyPlane(vec3 p, float height) {
    float base = sdPlane(p, height);
    float n = noise(p * 3.0 + iTime * 0.5) - 0.5;
    return base + n * 0.3;
}

const int NUM_OBJECTS = 3;

float sceneSDF(vec3 p, out int outIndex) {
    float objs[NUM_OBJECTS] = float[NUM_OBJECTS](
        sdSphere(p, 1.0),
        sdNoisyPlane(p, -1.0),
        sdBox(p, vec3(-2.0, 0.8, 0.5), vec3(0.2, 0.2, 0.5))
    );

    float mn = 1e5;
    outIndex = -1;

    for (int i = 0; i < NUM_OBJECTS; i++) {
        if (objs[i] < mn) {
            mn = objs[i];
            outIndex = i;
        }
    }

    return mn;
}

float sceneSDF(vec3 p) {
    int dummy;
    return sceneSDF(p, dummy);
}

vec3 calcNormal(vec3 p) {
    float eps = 0.0005;
    vec2 e = vec2(1.0, -1.0) * eps;
    return normalize(
        e.xyy * sceneSDF(p + e.xyy) +
        e.yyx * sceneSDF(p + e.yyx) +
        e.yxy * sceneSDF(p + e.yxy) +
        e.xxx * sceneSDF(p + e.xxx)
    );
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 phongLighting(vec3 p, vec3 normal, vec3 viewDir, vec3 baseColor) {
    vec3 lightPos = vec3(4.0, 5.0, -3.0);
    vec3 lightDir = normalize(lightPos - p);

    float ambientStrength = 0.15;
    vec3 ambient = ambientStrength * baseColor;

    float diff = max(dot(normal, lightDir), 0.0);
    vec3 diffuse = diff * baseColor;

    vec3 reflectDir = reflect(-lightDir, normal);
    float specStrength = 0.5;
    float shininess = 32.0;
    float spec = pow(max(dot(reflectDir, viewDir), 0.0), shininess);
    vec3 specular = specStrength * vec3(1.0) * spec;

    return ambient + diffuse + specular;
}

vec3 mainImage(vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;

    vec3 ro = vec3(0.0, 0.5, -8.0);
    vec3 rd = normalize(vec3(uv, 1.0));

    float depth = 0.0;
    bool hit = false;
    int hitIndex = -1;

    for (int i = 0; i < 150; i++) {
        vec3 p = ro + rd * depth;

        int idx;
        float dist = sceneSDF(p, idx);

        if (dist < 0.001) {
            hit = true;
            hitIndex = idx;
            break;
        }

        depth += dist;
        if (depth > 100.0) break;
    }

    vec3 col;
    if (hit) {
        vec3 p = ro + rd * depth;
        vec3 normal = calcNormal(p);
        vec3 viewDir = normalize(ro - p);

        vec3 baseColor;
        if (hitIndex == 0) {
            baseColor = vec3(1.0, 0.8, 0.1);
        } else if (hitIndex == 1) {
            baseColor = vec3(0.3, 0.3, 0.35);
        } else {
            float hueFromPos = p.x * 0.1 + p.y * 0.15 + p.z * 0.1;
            float hueFromNoise = noise(p * 2.0 - iTime * 0.3);
            float hue = fract(hueFromPos + hueFromNoise + iTime * 0.05);
            baseColor = hsv2rgb(vec3(hue, 0.75, 1.0));
        }

        col = phongLighting(p, normal, viewDir, baseColor);
    } else {
        col = vec3(0.0);
    }

    col = pow(col, vec3(0.4545));
    return col;
}

void main()
{
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);

    if (uv.x >= int(iResolution.x) || uv.y >= int(iResolution.y))
        return;

    vec2 fragCoord = vec2(float(uv.x) + 0.5, iResolution.y - float(uv.y) - 0.5);
    vec3 color = mainImage(fragCoord);

    imageStore(resultImage, uv, vec4(color, 1.0));
}
